const { booleans, extrusions, geometries } = require('@jscad/modeling')

const outline = [[76.2,-3],[76.5916,-2.9743],[76.9765,-2.8978],[77.3481,-2.7716],[77.7,-2.5981],[78.0263,-2.3801],[78.3213,-2.1213],[78.5801,-1.8263],[78.7981,-1.5],[78.9716,-1.1481],[79.0978,-0.7765],[79.1743,-0.3916],[79.2,0],[79.2,95.25],[79.1743,95.6416],[79.0978,96.0265],[78.9716,96.398],[78.7981,96.75],[78.5801,97.0763],[78.3213,97.3713],[78.0263,97.6301],[77.7,97.8481],[77.3481,98.0216],[76.9765,98.1478],[76.5916,98.2243],[76.2,98.25],[0,98.25],[-0.3916,98.2243],[-0.7765,98.1478],[-1.1481,98.0216],[-1.5,97.8481],[-1.8263,97.6301],[-2.1213,97.3713],[-2.3801,97.0763],[-2.5981,96.75],[-2.7716,96.398],[-2.8978,96.0265],[-2.9743,95.6416],[-3,95.25],[-3,0],[-2.9743,-0.3916],[-2.8978,-0.7765],[-2.7716,-1.1481],[-2.5981,-1.5],[-2.3801,-1.8263],[-2.1213,-2.1213],[-1.8263,-2.3801],[-1.5,-2.5981],[-1.1481,-2.7716],[-0.7765,-2.8978],[-0.3916,-2.9743],[0,-3]]
const holes = [[[2.525,2.525],[16.525,2.525],[16.525,16.525],[2.525,16.525]], [[21.575,2.525],[35.575,2.525],[35.575,16.525],[21.575,16.525]], [[40.625,2.525],[54.625,2.525],[54.625,16.525],[40.625,16.525]], [[59.675,2.525],[73.675,2.525],[73.675,16.525],[59.675,16.525]], [[2.525,21.575],[16.525,21.575],[16.525,35.575],[2.525,35.575]], [[21.575,21.575],[35.575,21.575],[35.575,35.575],[21.575,35.575]], [[40.625,21.575],[54.625,21.575],[54.625,35.575],[40.625,35.575]], [[59.675,31.1],[73.675,31.1],[73.675,45.1],[59.675,45.1]], [[72.205,22.837],[72.205,29.487],[59.905,29.487],[59.905,22.837]], [[72.205,46.713],[72.205,53.363],[59.905,53.363],[59.905,46.713]], [[2.525,40.625],[16.525,40.625],[16.525,54.625],[2.525,54.625]], [[21.575,40.625],[35.575,40.625],[35.575,54.625],[21.575,54.625]], [[40.625,40.625],[54.625,40.625],[54.625,54.625],[40.625,54.625]], [[2.525,59.675],[16.525,59.675],[16.525,73.675],[2.525,73.675]], [[21.575,59.675],[35.575,59.675],[35.575,73.675],[21.575,73.675]], [[40.625,59.675],[54.625,59.675],[54.625,73.675],[40.625,73.675]], [[59.675,69.2],[73.675,69.2],[73.675,83.2],[59.675,83.2]], [[72.205,60.937],[72.205,67.587],[59.905,67.587],[59.905,60.937]], [[72.205,84.813],[72.205,91.463],[59.905,91.463],[59.905,84.813]], [[12.05,78.725],[26.05,78.725],[26.05,92.725],[12.05,92.725]], [[3.787,80.195],[10.437,80.195],[10.437,92.495],[3.787,92.495]], [[27.663,80.195],[34.313,80.195],[34.313,92.495],[27.663,92.495]], [[40.625,78.725],[54.625,78.725],[54.625,92.725],[40.625,92.725]]]
const thickness = 1.5

const main = () => {
    const plate = geometries.geom2.fromPoints(outline)
    const cutouts = holes.map((hole) => geometries.geom2.fromPoints(hole))
    const profile = cutouts.length > 0 ? booleans.subtract(plate, ...cutouts) : plate
    return extrusions.extrudeLinear({ height: thickness }, profile)
}

module.exports = { main }
